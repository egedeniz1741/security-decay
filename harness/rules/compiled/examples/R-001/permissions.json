{
  "must_deny": [
    {
      "tool": "Read",
      "target": ".env"
    },
    {
      "tool": "Read",
      "target": "app/.env.local"
    },
    {
      "tool": "Read",
      "target": "secrets/api_key.txt"
    },
    {
      "tool": "Edit",
      "target": ".env"
    },
    {
      "tool": "Write",
      "target": "secrets/token.json"
    }
  ],
  "must_allow": [
    {
      "tool": "Read",
      "target": ".env.example"
    },
    {
      "tool": "Read",
      "target": "src/config.py"
    },
    {
      "tool": "Read",
      "target": "docs/secrets-policy.md"
    },
    {
      "tool": "Edit",
      "target": "README.md"
    }
  ]
}
