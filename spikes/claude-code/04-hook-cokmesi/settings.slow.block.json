{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/sd-spikes/hooks/slow.py\"",
            "timeout": 3,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
